# ============ 数据库 ============
# 生产（容器内）：host 用 db
# 本地开发：host 用 localhost
DB_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://keeper:change-me-to-a-long-random-string@localhost:5432/keeper

# 应用连接用普通角色（不是 postgres 超级用户，否则 RLS 会被绕过）
APP_DB_USER=keeper_app
APP_DB_PASSWORD=change-me-too

# ============ 应用 ============
APP_ENV=dev
# 会话签名密钥，生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-another-long-random-string
# 是否开放注册（false = 邀请制）
ALLOW_REGISTRATION=false

# ============ 模型 ============
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

FALLBACK_PROVIDER=qwen
FALLBACK_MODEL=qwen-vl-max
DASHSCOPE_API_KEY=

# ============ 推送 ============
WECOM_WEBHOOK=
PUSHPLUS_TOKEN=
