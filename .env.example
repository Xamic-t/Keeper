# ============ 应用 ============
APP_NAME=Keeper
APP_ENV=dev
APP_VERSION=0.1.0

# 会话签名密钥，生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-another-long-random-string

# 是否开放注册（false = 邀请制，由管理员建号）
ALLOW_REGISTRATION=false

# ============ 数据库 ============
# 生产（容器内）：host 用 db
# 本地开发：host 用 localhost
DB_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://keeper:change-me-to-a-long-random-string@localhost:5432/keeper

# 连接池：单账号 20 人规模，5 个连接足够
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# 打印 SQL（会带出插入的数据，含隐私，默认关闭）
DB_ECHO=false

# 应用连接用普通角色（不是 postgres 超级用户，否则 RLS 会被绕过）
APP_DB_USER=keeper_app
APP_DB_PASSWORD=change-me-too

# ============ 模型 ============
# 主通道（OpenAI 兼容协议）
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-flash
VISION_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# 备通道（主通道挂了自动切这里）
FALLBACK_PROVIDER=qwen
FALLBACK_MODEL=qwen-vl-max
FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# 单次模型调用超时（秒）
VISION_TIMEOUT_S=60

# ============ 安全与存储 ============
# 登录接口每 IP 每分钟允许的尝试次数（超过返回 429）
LOGIN_RATE_LIMIT=10
# 上传原图落盘根目录（容器里是 /app/data）
DATA_DIR=data
# 单张图片上限（MB）与一次最多传几张
MAX_UPLOAD_MB=8
MAX_UPLOAD_COUNT=10

# ============ 推送 ============
WECOM_WEBHOOK=
PUSHPLUS_TOKEN=
